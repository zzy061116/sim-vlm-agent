# 复制为 .env 并填入你的 key：cp .env.example .env
# 智谱 glm-4v-flash（视觉）和 glm-4-flash（规划）目前均免费，key 在 https://open.bigmodel.cn 领取
# 不填 key 也能跑：程序会自动进入离线模式（OFFLINE=1），用 BFS 离线规划器验证环境本身

LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VLM_MODEL=glm-4v-flash
LLM_MODEL=glm-4-flash
MAX_STEP=24
TIMEOUT=60
OFFLINE=0
